import Girth.TrainPhysicalEdgeNormalForm

/-!
# Least generated equivalence on physical train edges

Present the equivalence generated by elementary witness and standard
wagon links inductively. This removes an abstract least-closure
hypothesis from the physical normal-form theorem and leaves only
precisely checkable geometric obligations: tag preservation of each
generator, connectivity of a private standard wagon, genuine
shared-edge bridges and connectivity within each core wagon.

The module is purely algebraic. Its application to actual partite
picture embeddings remains a separate obligation.
-/

namespace StructuralRamsey.Girth

universe u v w x
variable {E : Type u} {Core : Type v} {I : Type w} {Old : Type x}

/-- Reflexive, symmetric, transitive closure of the elementary
edge-to-edge wagon relation. -/
inductive TrainEdgeGenerated (step : E → E → Prop) : E → E → Prop where
  | basic (a b : E) : step a b → TrainEdgeGenerated step a b
  | reflexive (a : E) : TrainEdgeGenerated step a a
  | symmetric (a b : E) :
      TrainEdgeGenerated step a b → TrainEdgeGenerated step b a
  | transitive (a b c : E) :
      TrainEdgeGenerated step a b →
      TrainEdgeGenerated step b c →
      TrainEdgeGenerated step a c

/-- The inductively generated relation is contained in every
equivalence relation containing all its elementary generating links. -/
theorem TrainEdgeGenerated.least
    (step T : E → E → Prop)
    (hRefl : ∀ a, T a a)
    (hSymm : ∀ a b, T a b → T b a)
    (hTrans : ∀ a b c, T a b → T b c → T a c)
    (hBasic : ∀ a b, step a b → T a b)
    {a b : E} (h : TrainEdgeGenerated step a b) :
    T a b := by
  induction h with
  | basic a b hab =>
      exact hBasic a b hab
  | reflexive a =>
      exact hRefl a
  | symmetric a b hab ih =>
      exact hSymm a b ih
  | transitive a b c hab hbc ihab ihbc =>
      exact hTrans a b c ihab ihbc

/-- The equivalence closure cannot equate physical edges with
different canonical shared/private labels if every generator
respects those labels. -/
theorem trainEdgeGenerated_tag_safe
    (tag : E → Core ⊕ (I × Old))
    (step : E → E → Prop)
    (hStepSafe : ∀ e f, step e f → tag e = tag f)
    {e f : E} (h : TrainEdgeGenerated step e f) :
    tag e = tag f := by
  exact TrainEdgeGenerated.least step
    (fun a b => tag a = tag b)
    (fun a => rfl)
    (fun a b hEq => hEq.symm)
    (fun a b c hab hbc => hab.trans hbc)
    hStepSafe h

/-- An exact generated-equivalence normal form with NO assumed
least-closure axiom. The remaining premises concern only physical
edge generators, old private-wagon paths and real shared H edges. -/
theorem trainEdgeGenerated_iff_sameTag
    (tag : E → Core ⊕ (I × Old))
    (inCore : E → Prop)
    (step : E → E → Prop)
    (hStepSafe : ∀ e f, step e f → tag e = tag f)
    (hPrivate : ∀ i a e f,
      tag e = Sum.inr (i, a) →
      tag f = Sum.inr (i, a) →
      TrainEdgeGenerated step e f)
    (hBridge : ∀ e c,
      tag e = Sum.inl c →
      ∃ g, inCore g ∧ tag g = Sum.inl c ∧
        TrainEdgeGenerated step e g)
    (hCore : ∀ e f c,
      inCore e → inCore f →
      tag e = Sum.inl c →
      tag f = Sum.inl c →
      TrainEdgeGenerated step e f) :
    ∀ e f, TrainEdgeGenerated step e f ↔ tag e = tag f := by
  have hLeast : ∀ T : E → E → Prop,
      (∀ e, T e e) →
      (∀ e f, T e f → T f e) →
      (∀ e f g, T e f → T f g → T e g) →
      (∀ e f, step e f → T e f) →
      ∀ e f, TrainEdgeGenerated step e f → T e f := by
    intro T hRefl hSymm hTrans hStep e f h
    exact TrainEdgeGenerated.least step T
      hRefl hSymm hTrans hStep h
  exact generatedEdgeRel_iff_sameTag
    tag inCore step (TrainEdgeGenerated step)
    hStepSafe hLeast
    (fun a b h => TrainEdgeGenerated.symmetric a b h)
    (fun a b c hab hbc => TrainEdgeGenerated.transitive a b c hab hbc)
    hPrivate hBridge hCore

end StructuralRamsey.Girth
