import Girth.TrainEdgeGeneratedClosure
import Girth.TrainWagonNodeGluing

/-!
# Generated wagon relations from explicit core and standard generators

At one horizontal cut, the physical output edge set is covered by
actual core edges and actual standard-picture edges. Define the
elementary generators to identify either two core edges in one
core wagon or two edges of one standard picture in one old wagon.

This explicit presentation automatically makes EVERY elementary
generator tag-safe. Moreover, any private tag forces its physical
edge to have the same standard-picture owner and old wagon label;
this follows directly from coverage and the shared/private tag
syntax, rather than being postulated as an additional hypothesis.

The resulting exact generated normal form needs only the genuine
core-edge bridge for each shared old wagon. It does not yet show
that every actual partite construction step supplies the required
cover, tag and shared-edge bridge maps.
-/

namespace StructuralRamsey.Girth

universe u v w x y z
variable {E : Type u} {Core : Type v} {Old : Type w}
variable {I : Type x} {CoreEdge : Type y} {OldEdge : Type z}

/-- The elementary generators of wagon equivalence: equality of
core wagon labels or equality of old wagon labels in one
standard picture. This is NOT equivalence merely of vertex
carriers, and keeps distinct wagon labels distinct. -/
inductive PictureWagonStep
    (coreEmbed : CoreEdge → E)
    (std : I → OldEdge → E)
    (coreClass : CoreEdge → Core)
    (oldClass : OldEdge → Old) : E → E → Prop where
  | core (a b : CoreEdge) (h : coreClass a = coreClass b) :
      PictureWagonStep coreEmbed std coreClass oldClass
        (coreEmbed a) (coreEmbed b)
  | standard (i : I) (a b : OldEdge)
      (h : oldClass a = oldClass b) :
      PictureWagonStep coreEmbed std coreClass oldClass
        (std i a) (std i b)

/-- Every physical private tag has the claimed UNIQUE
standard-copy index and old wagon label. In particular
a core edge cannot carry a private tag. -/
theorem privatePictureTag_has_standard_owner
    (coreEmbed : CoreEdge → E)
    (std : I → OldEdge → E)
    (coreClass : CoreEdge → Core)
    (oldClass : OldEdge → Old)
    (glue : I → Old → Option Core)
    (tag : E → Core ⊕ (I × Old))
    (hCoreTag : ∀ b, tag (coreEmbed b) = Sum.inl (coreClass b))
    (hStdTag : ∀ j b,
      tag (std j b) = gluedStandardNode glue j (oldClass b))
    (hCover : ∀ e : E,
      (∃ b, e = coreEmbed b) ∨ ∃ j b, e = std j b)
    (e : E) (i : I) (a : Old)
    (hTag : tag e = Sum.inr (i, a)) :
    ∃ b : OldEdge, e = std i b ∧ oldClass b = a := by
  rcases hCover e with ⟨b, he⟩ | ⟨j, b, he⟩
  · rw [he, hCoreTag b] at hTag
    cases hTag
  · rw [he, hStdTag j b] at hTag
    cases hg : glue j (oldClass b) with
    | some c =>
        simp [gluedStandardNode, hg] at hTag
    | none =>
        have hs :
            (Sum.inr (j, oldClass b) : Core ⊕ (I × Old)) =
              Sum.inr (i, a) := by
          simpa [gluedStandardNode, hg] using hTag
        have hpair : (j, oldClass b) = (i, a) := Sum.inr.inj hs
        have hji : j = i := congrArg Prod.fst hpair
        have hba : oldClass b = a := congrArg Prod.snd hpair
        refine ⟨b, ?_, hba⟩
        simpa [hji] using he

/-- The two explicit elementary generator families preserve the
canonical wagon tags, with NO additional label-safety axiom. -/
theorem pictureWagonStep_tag_safe
    (coreEmbed : CoreEdge → E)
    (std : I → OldEdge → E)
    (coreClass : CoreEdge → Core)
    (oldClass : OldEdge → Old)
    (glue : I → Old → Option Core)
    (tag : E → Core ⊕ (I × Old))
    (hCoreTag : ∀ b, tag (coreEmbed b) = Sum.inl (coreClass b))
    (hStdTag : ∀ j b,
      tag (std j b) = gluedStandardNode glue j (oldClass b))
    (e f : E)
    (hStep : PictureWagonStep coreEmbed std coreClass oldClass e f) :
    tag e = tag f := by
  cases hStep with
  | core a b h =>
      calc
        tag (coreEmbed a) = Sum.inl (coreClass a) := hCoreTag a
        _ = Sum.inl (coreClass b) := congrArg Sum.inl h
        _ = tag (coreEmbed b) := (hCoreTag b).symm
  | standard i a b h =>
      calc
        tag (std i a) = gluedStandardNode glue i (oldClass a) :=
          hStdTag i a
        _ = gluedStandardNode glue i (oldClass b) :=
          congrArg (gluedStandardNode glue i) h
        _ = tag (std i b) := (hStdTag i b).symm

/-- The least equivalence relation generated by the physical
core and standard-copy wagon relations is EXACTLY equality of
canonical wagon tags. The only nontrivial local hypothesis is
that a standard edge tagged by a shared core class can actually
reach a physical core edge of that class. -/
theorem pictureWagonGenerated_iff_sameTag
    (coreEmbed : CoreEdge → E)
    (std : I → OldEdge → E)
    (coreClass : CoreEdge → Core)
    (oldClass : OldEdge → Old)
    (glue : I → Old → Option Core)
    (tag : E → Core ⊕ (I × Old))
    (hCoreTag : ∀ b, tag (coreEmbed b) = Sum.inl (coreClass b))
    (hStdTag : ∀ j b,
      tag (std j b) = gluedStandardNode glue j (oldClass b))
    (hCover : ∀ e : E,
      (∃ b, e = coreEmbed b) ∨ ∃ j b, e = std j b)
    (hSharedBridge : ∀ j b c,
      glue j (oldClass b) = some c →
      ∃ d : CoreEdge, coreClass d = c ∧
        TrainEdgeGenerated
          (PictureWagonStep coreEmbed std coreClass oldClass)
          (std j b) (coreEmbed d)) :
    ∀ e f : E,
      TrainEdgeGenerated
        (PictureWagonStep coreEmbed std coreClass oldClass) e f ↔
      tag e = tag f := by
  let step := PictureWagonStep coreEmbed std coreClass oldClass
  have hSafe : ∀ e f, step e f → tag e = tag f :=
    pictureWagonStep_tag_safe coreEmbed std coreClass oldClass
      glue tag hCoreTag hStdTag
  have hPrivate : ∀ i a e f,
      tag e = Sum.inr (i, a) →
      tag f = Sum.inr (i, a) →
      TrainEdgeGenerated step e f := by
    intro i a e f he hf
    obtain ⟨b, hb, hclassb⟩ :=
      privatePictureTag_has_standard_owner
        coreEmbed std coreClass oldClass glue tag
        hCoreTag hStdTag hCover e i a he
    obtain ⟨d, hd, hclassd⟩ :=
      privatePictureTag_has_standard_owner
        coreEmbed std coreClass oldClass glue tag
        hCoreTag hStdTag hCover f i a hf
    rw [hb, hd]
    exact TrainEdgeGenerated.basic _ _
      (PictureWagonStep.standard i b d
        (hclassb.trans hclassd.symm))
  have hCore : ∀ e f c,
      (∃ b : CoreEdge, coreEmbed b = e) →
      (∃ d : CoreEdge, coreEmbed d = f) →
      tag e = Sum.inl c →
      tag f = Sum.inl c →
      TrainEdgeGenerated step e f := by
    rintro e f c ⟨b, hb⟩ ⟨d, hd⟩ he hf
    subst e
    subst f
    have hcb : coreClass b = c := by
      have hs :
          (Sum.inl (coreClass b) : Core ⊕ (I × Old)) =
            Sum.inl c := (hCoreTag b).symm.trans he
      exact Sum.inl.inj hs
    have hcd : coreClass d = c := by
      have hs :
          (Sum.inl (coreClass d) : Core ⊕ (I × Old)) =
            Sum.inl c := (hCoreTag d).symm.trans hf
      exact Sum.inl.inj hs
    exact TrainEdgeGenerated.basic _ _
      (PictureWagonStep.core b d (hcb.trans hcd.symm))
  have hBridge : ∀ e c,
      tag e = Sum.inl c →
      ∃ g, (∃ b : CoreEdge, coreEmbed b = g) ∧
        tag g = Sum.inl c ∧
        TrainEdgeGenerated step e g := by
    intro e c he
    rcases hCover e with ⟨b, hb⟩ | ⟨i, b, hb⟩
    · subst e
      refine ⟨coreEmbed b, ⟨b, rfl⟩, he, ?_⟩
      exact TrainEdgeGenerated.reflexive _
    · subst e
      have hs :
          gluedStandardNode glue i (oldClass b) =
            gluedCoreNode glue c := by
        change gluedStandardNode glue i (oldClass b) = Sum.inl c
        exact (hStdTag i b).symm.trans he
      have hc : glue i (oldClass b) = some c :=
        (gluedStandardNode_eq_core_iff glue i (oldClass b) c).mp hs
      obtain ⟨d, hdClass, hStep⟩ := hSharedBridge i b c hc
      refine ⟨coreEmbed d, ⟨d, rfl⟩, ?_, hStep⟩
      rw [hCoreTag d, hdClass]
  exact trainEdgeGenerated_iff_sameTag
    tag (fun e => ∃ b : CoreEdge, coreEmbed b = e)
    step hSafe hPrivate hBridge hCore

end StructuralRamsey.Girth
