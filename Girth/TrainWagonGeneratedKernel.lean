import Girth.TrainWagonNodeGluing

/-!
# Minimal equivalence generated by wagon-ancestor gluing

The tagged shared/private ancestor model is not just a convenient
representation: its equality kernel is the *least equivalence relation*
which identifies each standard ancestor with its specified core ancestor.

This theorem uses no generated train edge equivalence, no cycle-girth
assumption, and no finiteness assumption. To apply it to the circulation
picture step one must still prove that the actual edge-equivalence
generators consist of precisely these core links, and verify the
one-core-ancestor-per-old-ancestor gluing interface.
-/

namespace StructuralRamsey.Girth

universe u v w
variable {Core : Type u} {Old : Type v} {I : Type w}

/-- Evaluation from the disjoint union of all pre-identification
ancestor nodes to the tagged shared/private representation. -/
def wagonAncestorNormalForm
    (glue : I → Old → Option Core) :
    (Core ⊕ (I × Old)) → GluedWagonNode Core Old I glue
  | .inl c => gluedCoreNode glue c
  | .inr z => gluedStandardNode glue z.1 z.2

/-- The kernel of the explicit node normal form is an equivalence. -/
def wagonAncestorKernel (glue : I → Old → Option Core)
    (x y : Core ⊕ (I × Old)) : Prop :=
  wagonAncestorNormalForm glue x = wagonAncestorNormalForm glue y

theorem wagonAncestorKernel_refl
    (glue : I → Old → Option Core) (x : Core ⊕ (I × Old)) :
    wagonAncestorKernel glue x x := rfl

theorem wagonAncestorKernel_symm
    (glue : I → Old → Option Core) {x y : Core ⊕ (I × Old)}
    (h : wagonAncestorKernel glue x y) :
    wagonAncestorKernel glue y x := h.symm

theorem wagonAncestorKernel_trans
    (glue : I → Old → Option Core) {x y z : Core ⊕ (I × Old)}
    (hxy : wagonAncestorKernel glue x y)
    (hyz : wagonAncestorKernel glue y z) :
    wagonAncestorKernel glue x z := hxy.trans hyz

/-- Every designated gluing link belongs to the normal-form kernel. -/
theorem wagonAncestorKernel_link
    (glue : I → Old → Option Core)
    (i : I) (a : Old) (c : Core)
    (h : glue i a = some c) :
    wagonAncestorKernel glue
      (Sum.inr (i, a)) (Sum.inl c) := by
  simp [wagonAncestorKernel, wagonAncestorNormalForm,
    gluedCoreNode, gluedStandardNode, h]

/-- The kernel is contained in EVERY equivalence relation that contains
the genuine local-to-core links. Thus the kernel is exactly the
equivalence closure of those links, without an appeal to a quotient
or to an informal transitive-closure argument. -/
theorem wagonAncestorKernel_minimal
    (glue : I → Old → Option Core)
    (R : (Core ⊕ (I × Old)) → (Core ⊕ (I × Old)) → Prop)
    (hRefl : ∀ x, R x x)
    (hSymm : ∀ x y, R x y → R y x)
    (hTrans : ∀ x y z, R x y → R y z → R x z)
    (hLink : ∀ i a c, glue i a = some c →
      R (Sum.inr (i, a)) (Sum.inl c))
    (x y : Core ⊕ (I × Old))
    (hEq : wagonAncestorKernel glue x y) :
    R x y := by
  change wagonAncestorNormalForm glue x =
    wagonAncestorNormalForm glue y at hEq
  cases x with
  | inl c =>
      cases y with
      | inl d =>
          have hcd : c = d := by
            simpa [wagonAncestorNormalForm, gluedCoreNode] using hEq
          subst d
          exact hRefl _
      | inr z =>
          rcases z with ⟨j, b⟩
          cases hb : glue j b with
          | none =>
              simp [wagonAncestorNormalForm, gluedCoreNode,
                gluedStandardNode, hb] at hEq
          | some d =>
              have hcd : c = d := by
                  simpa [wagonAncestorNormalForm, gluedCoreNode,
                    gluedStandardNode, hb] using hEq
              subst d
              exact hSymm _ _ (hLink j b c hb)
  | inr z =>
      rcases z with ⟨i, a⟩
      cases y with
      | inl d =>
          cases ha : glue i a with
          | none =>
              simp [wagonAncestorNormalForm, gluedCoreNode,
                gluedStandardNode, ha] at hEq
          | some c =>
              have hcd : c = d := by
                  simpa [wagonAncestorNormalForm, gluedCoreNode,
                    gluedStandardNode, ha] using hEq
              subst d
              exact hLink i a c ha
      | inr z =>
          rcases z with ⟨j, b⟩
          cases ha : glue i a with
          | none =>
              cases hb : glue j b with
              | none =>
                  have hraw :
                      (Sum.inr (i, a) : Core ⊕ (I × Old)) =
                        Sum.inr (j, b) := by
                    simpa [wagonAncestorNormalForm,
                      gluedStandardNode, ha, hb] using hEq
                  rw [hraw]
                  exact hRefl _
              | some d =>
                  simp [wagonAncestorNormalForm,
                    gluedStandardNode, ha, hb] at hEq
          | some c =>
              cases hb : glue j b with
              | none =>
                  simp [wagonAncestorNormalForm,
                    gluedStandardNode, ha, hb] at hEq
              | some d =>
                  have hcd : c = d := by
                      simpa [wagonAncestorNormalForm,
                        gluedStandardNode, ha, hb] using hEq
                  subst d
                  exact hTrans _ _ _
                    (hLink i a c ha)
                    (hSymm _ _ (hLink j b c hb))

end StructuralRamsey.Girth
