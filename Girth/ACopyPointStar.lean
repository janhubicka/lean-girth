import Girth.ACopyExactStar
import Girth.ACopyOverlapRealization

/-!
# Exact star gluing for supported point occurrences

This instantiates `ACopyExactStar.SourceStar` with the actual occurrence sets
`Ω × K` of coherent overlap diagrams. The shared node embeddings preserve and
reflect overlap graphs. This gives the required compatibility of occurrence
setoids; no assertion about the final quotient is an input.

The output is the quotient generated by source overlap equalities and literal
shared-coordinate identifications. Core/source point maps are injective, and
their intersections are exactly the shared-coordinate images. Every output
point comes from a physical-node occurrence. Reading output overlaps from
point equality gives a coherent diagram whose realization is this same point
quotient.

Scope: all source points here are supported occurrences. Retained unsupported
chart records, relation decorations, active-domain coverage for a preexisting
relational gluing, and the separate quotient of basic node labels are not
constructed. Output node labels remain the disjoint sum of source node labels;
each shared node therefore has distinct raw labels with the same full carrier.
No linearity or exact-support conclusion is asserted, before or after a
separate node quotient without further geometric hypotheses. We do not
identify relational copies or wagon labels by carriers.
-/

namespace StructuralRamsey.Girth.ACopyPointStar

open ACopyExactStar

universe u v w x y z

/-- A node embedding preserving and reflecting every binary coordinate label. -/
structure DiagramEmbedding {Ω : Type u} {Ω' : Type v} {K : Type w}
    (D : CoherentOverlap Ω K) (E : CoherentOverlap Ω' K) where
  node : Ω ↪ Ω'
  rel_iff : ∀ e f a b, E.Rel (node e) (node f) a b ↔ D.Rel e f a b

/-- Coherent source diagrams glued through shared coherent node diagrams. -/
structure Data (CoreNode : Type u) (I : Type v) (SourceNode : I → Type w)
    (SharedNode : I → Type x) (K : Type y) where
  core : CoherentOverlap CoreNode K
  source : (i : I) → CoherentOverlap (SourceNode i) K
  shared : (i : I) → CoherentOverlap (SharedNode i) K
  toCore : (i : I) → DiagramEmbedding (shared i) core
  toSource : (i : I) → DiagramEmbedding (shared i) (source i)

namespace Data

variable {CoreNode : Type u} {I : Type v} {SourceNode : I → Type w}
    {SharedNode : I → Type x} {K : Type y}
variable (D : Data CoreNode I SourceNode SharedNode K)

def coreOccurrence (i : I) (p : SharedNode i × K) : CoreNode × K :=
  ((D.toCore i).node p.1, p.2)

def sourceOccurrence (i : I) (p : SharedNode i × K) : SourceNode i × K :=
  ((D.toSource i).node p.1, p.2)

theorem coreOccurrence_injective (i : I) : Function.Injective (D.coreOccurrence i) := by
  intro p q h
  exact Prod.ext ((D.toCore i).node.injective (congrArg Prod.fst h))
    (congrArg (fun p : CoreNode × K => p.2) h)

theorem sourceOccurrence_injective (i : I) :
    Function.Injective (D.sourceOccurrence i) := by
  intro p q h
  exact Prod.ext ((D.toSource i).node.injective (congrArg Prod.fst h))
    (congrArg (fun p : SourceNode i × K => p.2) h)

/-- The common shared diagram supplies both directions of compatibility. -/
theorem occurrence_compatible (i : I) (p q : SharedNode i × K) :
    D.core.occurrenceSetoid (D.coreOccurrence i p) (D.coreOccurrence i q) ↔
      (D.source i).occurrenceSetoid (D.sourceOccurrence i p) (D.sourceOccurrence i q) :=
  ((D.toCore i).rel_iff p.1 q.1 p.2 q.2).trans
    ((D.toSource i).rel_iff p.1 q.1 p.2 q.2).symm

abbrev Raw := ClassStar.Raw (CoreNode × K) (fun i => SourceNode i × K)

/-- Only existing source equalities and literal shared coordinates generate
the output point quotient. -/
abbrev Step := SourceStar.Step D.core.occurrenceSetoid
  (fun i => (D.source i).occurrenceSetoid) D.coreOccurrence D.sourceOccurrence

abbrev Generated := Relation.EqvGen D.Step

def Point := Quot D.Step

def corePoint (e : CoreNode) (a : K) : D.Point := Quot.mk _ (.inl (e, a))

def sourcePoint (i : I) (e : SourceNode i) (a : K) : D.Point :=
  Quot.mk _ (.inr ⟨i, (e, a)⟩)

def coreMap : D.core.Point → D.Point := fun p =>
  SourceStar.classToQuotient D.core.occurrenceSetoid
    (fun i => (D.source i).occurrenceSetoid) D.coreOccurrence D.sourceOccurrence (.inl p)

def sourceMap (i : I) : (D.source i).Point → D.Point := fun p =>
  SourceStar.classToQuotient D.core.occurrenceSetoid
    (fun j => (D.source j).occurrenceSetoid) D.coreOccurrence D.sourceOccurrence (.inr ⟨i, p⟩)

@[simp] theorem coreMap_nodePoint (e : CoreNode) (a : K) :
    D.coreMap (D.core.nodePoint e a) = D.corePoint e a := rfl

@[simp] theorem sourceMap_nodePoint (i : I) (e : SourceNode i) (a : K) :
    D.sourceMap i ((D.source i).nodePoint e a) = D.sourcePoint i e a := rfl

theorem coreMap_injective : Function.Injective D.coreMap :=
  SourceStar.core_classMap_injective D.core.occurrenceSetoid
    (fun i => (D.source i).occurrenceSetoid) D.coreOccurrence D.sourceOccurrence
    D.occurrence_compatible

theorem sourceMap_injective (i : I) : Function.Injective (D.sourceMap i) :=
  SourceStar.source_classMap_injective D.core.occurrenceSetoid
    (fun j => (D.source j).occurrenceSetoid) D.coreOccurrence D.sourceOccurrence
    D.occurrence_compatible i

/-- Generated equality inside the core is exactly its original overlap. -/
theorem corePoint_eq_iff (e f : CoreNode) (a b : K) :
    D.corePoint e a = D.corePoint f b ↔ D.core.Rel e f a b := by
  change Quot.mk D.Step _ = Quot.mk D.Step _ ↔ _
  rw [Quot.eq]
  exact SourceStar.generated_core_iff D.core.occurrenceSetoid
    (fun i => (D.source i).occurrenceSetoid) D.coreOccurrence D.sourceOccurrence
    D.occurrence_compatible (e, a) (f, b)

/-- Generated equality inside each source is exactly its original overlap. -/
theorem sourcePoint_eq_iff (i : I) (e f : SourceNode i) (a b : K) :
    D.sourcePoint i e a = D.sourcePoint i f b ↔ (D.source i).Rel e f a b := by
  change Quot.mk D.Step _ = Quot.mk D.Step _ ↔ _
  rw [Quot.eq]
  exact SourceStar.generated_source_iff D.core.occurrenceSetoid
    (fun j => (D.source j).occurrenceSetoid) D.coreOccurrence D.sourceOccurrence
    D.occurrence_compatible i (e, a) (f, b)

/-- A source point meets a core point precisely through a shared coordinate,
allowing different representatives of both original point classes. -/
theorem sourcePoint_eq_corePoint_iff (i : I) (e : SourceNode i)
    (f : CoreNode) (a b : K) :
    D.sourcePoint i e a = D.corePoint f b ↔
      ∃ q : SharedNode i, ∃ c : K,
        (D.source i).Rel ((D.toSource i).node q) e c a ∧
        D.core.Rel ((D.toCore i).node q) f c b := by
  have h := SourceStar.generated_source_core_iff D.core.occurrenceSetoid
      (fun j => (D.source j).occurrenceSetoid) D.coreOccurrence D.sourceOccurrence
      D.occurrence_compatible i (e, a) (f, b)
  constructor
  · intro heq
    obtain ⟨⟨q, c⟩, hs, hc⟩ := h.mp (Quot.eqvGen_exact heq)
    exact ⟨q, c, hs, hc⟩
  · rintro ⟨q, c, hs, hc⟩
    exact Quot.eqvGen_sound (h.mpr ⟨(q, c), hs, hc⟩)

theorem sharedPoint_eq (i : I) (q : SharedNode i) (a : K) :
    D.sourcePoint i ((D.toSource i).node q) a =
      D.corePoint ((D.toCore i).node q) a :=
  Quot.sound (SourceStar.Step.shared (coreEq := D.core.occurrenceSetoid)
    (sourceEq := fun j => (D.source j).occurrenceSetoid)
    (alpha := D.coreOccurrence) (beta := D.sourceOccurrence) i (q, a))

/-- Distinct sources can meet only through an actual common core point. -/
theorem distinct_sourcePoint_eq_iff_core (i j : I) (hij : i ≠ j)
    (e : SourceNode i) (f : SourceNode j) (a b : K) :
    D.sourcePoint i e a = D.sourcePoint j f b ↔
      ∃ c : CoreNode, ∃ d : K,
        D.sourcePoint i e a = D.corePoint c d ∧
        D.sourcePoint j f b = D.corePoint c d := by
  have h := SourceStar.generated_distinct_sources_iff D.core.occurrenceSetoid
    (fun k => (D.source k).occurrenceSetoid) D.coreOccurrence D.sourceOccurrence
    D.occurrence_compatible i j hij (e, a) (f, b)
  constructor
  · intro heq
    obtain ⟨⟨c, d⟩, hi, hj⟩ := h.mp (Quot.eqvGen_exact heq)
    exact ⟨c, d, Quot.eqvGen_sound hi, Quot.eqvGen_sound hj⟩
  · rintro ⟨c, d, hi, hj⟩
    exact Quot.eqvGen_sound (h.mpr
      ⟨(c, d), Quot.eqvGen_exact hi, Quot.eqvGen_exact hj⟩)

/-- Explicit cross-source overlap: shared representatives are joined by the
core's existing overlap graph, including cross-coordinate identifications. -/
theorem distinct_sourcePoint_eq_iff (i j : I) (hij : i ≠ j)
    (e : SourceNode i) (f : SourceNode j) (a b : K) :
    D.sourcePoint i e a = D.sourcePoint j f b ↔
      ∃ q : SharedNode i, ∃ r : SharedNode j, ∃ c d : K,
        (D.source i).Rel ((D.toSource i).node q) e c a ∧
        D.core.Rel ((D.toCore i).node q) ((D.toCore j).node r) c d ∧
        (D.source j).Rel ((D.toSource j).node r) f d b := by
  rw [D.distinct_sourcePoint_eq_iff_core i j hij e f a b]
  constructor
  · rintro ⟨g, t, hi, hj⟩
    obtain ⟨q, c, hq, hc⟩ := (D.sourcePoint_eq_corePoint_iff i e g a t).mp hi
    obtain ⟨r, d, hr, hd⟩ := (D.sourcePoint_eq_corePoint_iff j f g b t).mp hj
    exact ⟨q, r, c, d, hq, D.core.compose hc (D.core.reverse hd), hr⟩
  · rintro ⟨q, r, c, d, hq, hcore, hr⟩
    refine ⟨(D.toCore i).node q, c, ?_, ?_⟩
    · exact (D.sourcePoint_eq_corePoint_iff i e _ a c).mpr
        ⟨q, c, hq, D.core.refl _ _⟩
    · exact (D.sourcePoint_eq_corePoint_iff j f _ b c).mpr
        ⟨r, d, hr, D.core.reverse hcore⟩

def coreImage : Set D.Point := {x | ∃ e a, D.corePoint e a = x}

def sourceImage (i : I) : Set D.Point := {x | ∃ e a, D.sourcePoint i e a = x}

def sharedImage (i : I) : Set D.Point :=
  {x | ∃ q a, D.corePoint ((D.toCore i).node q) a = x}

theorem coreImage_eq_range_coreMap : D.coreImage = Set.range D.coreMap := by
  ext p
  constructor
  · rintro ⟨e, a, h⟩
    exact ⟨D.core.nodePoint e a, h⟩
  · rintro ⟨q, rfl⟩
    induction q using Quotient.inductionOn with
    | h q => exact ⟨q.1, q.2, rfl⟩

theorem sourceImage_eq_range_sourceMap (i : I) :
    D.sourceImage i = Set.range (D.sourceMap i) := by
  ext p
  constructor
  · rintro ⟨e, a, h⟩
    exact ⟨(D.source i).nodePoint e a, h⟩
  · rintro ⟨q, rfl⟩
    induction q using Quotient.inductionOn with
    | h q => exact ⟨q.1, q.2, rfl⟩

/-- Contact depends on the whole point class meeting a shared node, not on
whether the chosen occurrence itself has a shared node label. -/
theorem sourcePoint_mem_coreImage_iff (i : I) (e : SourceNode i) (a : K) :
    D.sourcePoint i e a ∈ D.coreImage ↔
      ∃ q c, (D.source i).Rel ((D.toSource i).node q) e c a := by
  constructor
  · rintro ⟨f, b, h⟩
    obtain ⟨q, c, hs, _⟩ := (D.sourcePoint_eq_corePoint_iff i e f a b).mp h.symm
    exact ⟨q, c, hs⟩
  · rintro ⟨q, c, hs⟩
    exact ⟨(D.toCore i).node q, c,
      ((D.sourcePoint_eq_corePoint_iff i e _ a c).mpr
        ⟨q, c, hs, D.core.refl _ _⟩).symm⟩

/-- The source/core intersection is exactly the shared physical-node point image. -/
theorem sourceImage_inter_coreImage (i : I) :
    D.sourceImage i ∩ D.coreImage = D.sharedImage i := by
  ext x
  constructor
  · rintro ⟨⟨e, a, rfl⟩, f, b, hcore⟩
    obtain ⟨q, c, hq, _⟩ := (D.sourcePoint_eq_corePoint_iff i e f a b).mp hcore.symm
    exact ⟨q, c, (D.sharedPoint_eq i q c).symm.trans
      ((D.sourcePoint_eq_iff i _ e c a).mpr hq)⟩
  · rintro ⟨q, a, rfl⟩
    exact ⟨⟨(D.toSource i).node q, a, D.sharedPoint_eq i q a⟩,
      (D.toCore i).node q, a, rfl⟩

/-- Two different sources intersect exactly in the intersection of their
shared images in the core. -/
theorem distinct_sourceImage_inter (i j : I) (hij : i ≠ j) :
    D.sourceImage i ∩ D.sourceImage j = D.sharedImage i ∩ D.sharedImage j := by
  ext x
  constructor
  · intro h
    obtain ⟨e, a, he⟩ := h.1
    obtain ⟨f, b, hf⟩ := h.2
    obtain ⟨c, d, hc, _⟩ := (D.distinct_sourcePoint_eq_iff_core i j hij e f a b).mp
      (he.trans hf.symm)
    have hcore : x ∈ D.coreImage := ⟨c, d, hc.symm.trans he⟩
    exact ⟨D.sourceImage_inter_coreImage i ▸ ⟨h.1, hcore⟩,
      D.sourceImage_inter_coreImage j ▸ ⟨h.2, hcore⟩⟩
  · intro h
    have hi : x ∈ D.sourceImage i ∩ D.coreImage :=
      D.sourceImage_inter_coreImage i ▸ h.1
    have hj : x ∈ D.sourceImage j ∩ D.coreImage :=
      D.sourceImage_inter_coreImage j ▸ h.2
    exact ⟨hi.1, hj.1⟩

/-- All output points come from physical-node occurrences; there are no
additional point generators in this supported-occurrence construction. -/
theorem point_covered (p : D.Point) :
    (∃ e a, D.corePoint e a = p) ∨ (∃ i e a, D.sourcePoint i e a = p) := by
  induction p using Quot.inductionOn with
  | h p =>
      cases p with
      | inl p => exact Or.inl ⟨p.1, p.2, rfl⟩
      | inr p => exact Or.inr ⟨p.1, p.2.1, p.2.2, rfl⟩

/-- Raw node labels; shared copies have not yet been identified as node labels. -/
abbrev Node := CoreNode ⊕ Sigma SourceNode

def nodePoint : Node (CoreNode := CoreNode) (SourceNode := SourceNode) → K → D.Point
  | .inl e, a => D.corePoint e a
  | .inr ⟨i, e⟩, a => D.sourcePoint i e a

theorem nodePoint_injective (e : Node (CoreNode := CoreNode) (SourceNode := SourceNode)) :
    Function.Injective (D.nodePoint e) := by
  intro a b h
  cases e with
  | inl e => exact (D.core.diagonal e a b).mp ((D.corePoint_eq_iff e e a b).mp h)
  | inr s =>
      rcases s with ⟨i, e⟩
      exact ((D.source i).diagonal e a b).mp ((D.sourcePoint_eq_iff i e e a b).mp h)

def nodeEmbedding (e : Node (CoreNode := CoreNode) (SourceNode := SourceNode)) : K ↪ D.Point :=
  ⟨D.nodePoint e, D.nodePoint_injective e⟩

/-- Complete output overlap labels, read from the genuinely generated quotient. -/
def output : CoherentOverlap (Node (CoreNode := CoreNode) (SourceNode := SourceNode)) K :=
  CoherentOverlap.ofCharts D.nodeEmbedding

theorem output_rel_core_iff (e f : CoreNode) (a b : K) :
    D.output.Rel (.inl e) (.inl f) a b ↔ D.core.Rel e f a b :=
  D.corePoint_eq_iff e f a b

theorem output_rel_source_iff (i : I) (e f : SourceNode i) (a b : K) :
    D.output.Rel (.inr ⟨i, e⟩) (.inr ⟨i, f⟩) a b ↔ (D.source i).Rel e f a b :=
  D.sourcePoint_eq_iff i e f a b

theorem nodePoint_covered (p : D.Point) : ∃ e a, D.nodePoint e a = p := by
  rcases D.point_covered p with ⟨e, a, h⟩ | ⟨i, e, a, h⟩
  · exact ⟨.inl e, a, h⟩
  · exact ⟨.inr ⟨i, e⟩, a, h⟩

/-- Completing the output overlap diagram and realizing it reproduces the
same generated point quotient. This is independent of a later node quotient. -/
noncomputable def outputPointEquiv : D.output.Point ≃ D.Point :=
  CoherentOverlap.ambientEquiv D.nodeEmbedding D.nodePoint_covered

@[simp] theorem outputPointEquiv_nodePoint
    (e : Node (CoreNode := CoreNode) (SourceNode := SourceNode)) (a : K) :
    D.outputPointEquiv (D.output.nodePoint e a) = D.nodePoint e a := rfl

end Data
end StructuralRamsey.Girth.ACopyPointStar
