import Mathlib.Tactic

/-!
# Actual edge-generated equivalence from shared/private wagon labels

A standard picture extension has an explicit shared/private ancestor label
for every ACTUAL edge. This module isolates the exact two arguments needed
to identify the LEAST edge-equivalence relation generated by witness and
standard-picture relations with equality of those labels.

(1) Every genuine generator preserves the label, so the least generated
relation preserves it.
(2) Equal private labels join inside one old wagon. Equal shared labels
join through actual core edges of that wagon, using core transitivity.

This is a conditional edge-level theorem, not an assumption that abstract
ancestor tags automatically represent actual physical glue. The geometric
picture step must establish the generator, private-fibre, bridge and
core-fibre hypotheses from its real edges.
-/

namespace StructuralRamsey.Girth

universe u v w x
variable {E : Type u} {Core : Type v} {I : Type w} {Old : Type x}

/-- The least equivalence generated by tag-preserving elementary
steps cannot identify two edges with different shared/private tags. -/
theorem generatedEdgeRel_respects_tag
    (tag : E → Core ⊕ (I × Old))
    (step R : E → E → Prop)
    (hStepSafe : ∀ e f, step e f → tag e = tag f)
    (hLeast : ∀ T : E → E → Prop,
      (∀ e, T e e) →
      (∀ e f, T e f → T f e) →
      (∀ e f g, T e f → T f g → T e g) →
      (∀ e f, step e f → T e f) →
      ∀ e f, R e f → T e f) :
    ∀ e f, R e f → tag e = tag f := by
  intro e f h
  exact hLeast (fun a b => tag a = tag b)
    (fun _ => rfl)
    (fun _ _ hEq => hEq.symm)
    (fun _ _ _ hEq hEq' => hEq.trans hEq')
    hStepSafe e f h

/-- Conversely, actual fibre connectivity identifies any two edges
with the same label. Private labels use their old standard wagon.
For a shared core label, each edge has an R-path to a REAL core
edge of that label, and all such core edges are R-equivalent. -/
theorem sameEdgeTag_rel_of_bridges
    (tag : E → Core ⊕ (I × Old))
    (inCore : E → Prop)
    (R : E → E → Prop)
    (hSymm : ∀ e f, R e f → R f e)
    (hTrans : ∀ e f g, R e f → R f g → R e g)
    (hPrivate : ∀ i a e f,
      tag e = Sum.inr (i, a) →
      tag f = Sum.inr (i, a) → R e f)
    (hBridge : ∀ e c,
      tag e = Sum.inl c →
      ∃ g, inCore g ∧ tag g = Sum.inl c ∧ R e g)
    (hCore : ∀ e f c,
      inCore e → inCore f →
      tag e = Sum.inl c →
      tag f = Sum.inl c → R e f)
    (e f : E) (hEq : tag e = tag f) :
    R e f := by
  cases htag : tag e with
  | inl c =>
      have hf : tag f = Sum.inl c := hEq.symm.trans htag
      obtain ⟨g, hgCore, hgTag, heg⟩ := hBridge e c htag
      obtain ⟨h, hhCore, hhTag, hfh⟩ := hBridge f c hf
      have hgh : R g h :=
        hCore g h c hgCore hhCore hgTag hhTag
      exact hTrans e g f heg
        (hTrans g h f hgh (hSymm f h hfh))
  | inr z =>
      rcases z with ⟨i, a⟩
      have hf : tag f = Sum.inr (i, a) := hEq.symm.trans htag
      exact hPrivate i a e f htag hf

/-- The actual generated edge relation is exactly equality of its
canonical shared/private ancestor labels if the defining elementary
steps are label-safe and every label fibre has the stated physical
bridge property. This is the precise missing kernel interface in
the circulation manuscript's generated train equivalence proof. -/
theorem generatedEdgeRel_iff_sameTag
    (tag : E → Core ⊕ (I × Old))
    (inCore : E → Prop)
    (step R : E → E → Prop)
    (hStepSafe : ∀ e f, step e f → tag e = tag f)
    (hLeast : ∀ T : E → E → Prop,
      (∀ e, T e e) →
      (∀ e f, T e f → T f e) →
      (∀ e f g, T e f → T f g → T e g) →
      (∀ e f, step e f → T e f) →
      ∀ e f, R e f → T e f)
    (hSymm : ∀ e f, R e f → R f e)
    (hTrans : ∀ e f g, R e f → R f g → R e g)
    (hPrivate : ∀ i a e f,
      tag e = Sum.inr (i, a) →
      tag f = Sum.inr (i, a) → R e f)
    (hBridge : ∀ e c,
      tag e = Sum.inl c →
      ∃ g, inCore g ∧ tag g = Sum.inl c ∧ R e g)
    (hCore : ∀ e f c,
      inCore e → inCore f →
      tag e = Sum.inl c →
      tag f = Sum.inl c → R e f) :
    ∀ e f, R e f ↔ tag e = tag f := by
  intro e f
  constructor
  · exact generatedEdgeRel_respects_tag
      tag step R hStepSafe hLeast e f
  · exact sameEdgeTag_rel_of_bridges
      tag inCore R hSymm hTrans hPrivate hBridge hCore e f

end StructuralRamsey.Girth
