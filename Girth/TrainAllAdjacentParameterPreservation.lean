import Girth.TrainFullSystemGirthParameter
import Girth.TrainUniversalTopOrderOne

/-!
# Circulation: all adjacent wagon parameters in one picture step

The manuscript's parameter at level nu compares the (nu-1)-wagons
belonging to one nu-wagon. We expose this as an adjacent-cut predicate,
avoiding spurious bounds for arbitrary nonadjacent cuts.

For the ACTUAL relational A-support train generated by one active
picture step, combine:
* old/core allowed sibling parameters at each adjacent cut;
* the full simultaneous-replacement system-girth bound at each
  interior parent cut;
* the automatic universal-top bridge with NO cycle assumption.

This is the complete conditional parameter-preservation interface
for a picture step. Higher-order acceptable-cycle preservation,
the existence of the recursive witnesses, and the Ramsey induction
are genuinely separate circulation obligations. No appendix is used.
-/

namespace StructuralRamsey.Girth

open StructuralRamsey.RelStructure

universe u v
variable {L : RelLanguage.{u}} {UA P Old Core I : Type v}
variable {E W : Type v}

/-- Correct adjacent-cut formulation of the train's allowed
sibling-intersection parameters. The parameter at parent cut
nu applies to children at cut mu where nu = mu + 1. -/
def EdgeTrainLevels.AdjacentParameters
    {m : ℕ} (T : EdgeTrainLevels E m)
    (edgeCarrier : E → Set W)
    (allowed : Fin (m + 1) → Set W) : Prop :=
  ∀ (μ ν : Fin (m + 1)) (hμν : μ ≤ ν),
    ν.val = μ.val + 1 →
      TrainParentIntersectionBound
        (T.wagonClassCarrier edgeCarrier μ)
        (T.wagonParent μ ν hμν)
        (allowed ν)

/-- All original allowed-part sibling-intersection bounds survive
a genuine active relational picture step, under the old/core
parameters and full witness system girth at interior parent cuts.
No top-coordinate system girth is required. -/
theorem activeAttached_actualASupport_allAdjacentParameters
    {m : ℕ}
    (A : RelStructure L UA)
    (hA : A.Irreducible)
    (B : StructuralRamsey.Partite.System L P Old)
    (α : UA → P)
    (D : RelStructure L Core)
    (f : I → RelStructure.Embedding
      (B.toRelStructure.induce (activeCarrier A B α)) D)
    (oldTrain : EdgeTrainLevels (OldACarrierEdge A B.toRelStructure) m)
    (coreTrain : EdgeTrainLevels (OldACarrierEdge A D) m)
    (hShared : ∀ i : I,
      Nonempty (SharedOldACarrierEdge A B.toRelStructure
        (activeCarrier A B α)))
    (hRel : ∀ κ : Fin (m + 1), ∀ i s t,
      oldTrain.rel κ
        (sharedOldACarrierInclusion A B.toRelStructure
          (activeCarrier A B α) s)
        (sharedOldACarrierInclusion A B.toRelStructure
          (activeCarrier A B α) t) ↔
      coreTrain.rel κ
        (sharedOldACarrierCoreEmbedding A B.toRelStructure
          (activeCarrier A B α) D f i s)
        (sharedOldACarrierCoreEmbedding A B.toRelStructure
          (activeCarrier A B α) D f i t))
    (allowed : Fin (m + 1) → Set
      (RelStructure.Attachment.Vertex
        (activeCarrier A B α) (W := Core) (I := I)))
    (hOld : ∀ i : I,
      oldTrain.AdjacentParameters
        (attachedOldAEdgeCarrier A B.toRelStructure
          (activeCarrier A B α) D f i) allowed)
    (hCore : coreTrain.AdjacentParameters
      (attachedCoreAEdgeCarrier A B.toRelStructure
        (activeCarrier A B α) D f) allowed)
    (g : Fin (m + 1) → ℕ)
    (hg : ∀ ν : Fin (m + 1), 0 < ν.val → ν.val < m → 1 ≤ g ν)
    (hFull : ∀ ν : Fin (m + 1), 0 < ν.val → ν.val < m →
      (sharedWitnessOrderOneData coreTrain ν
        (sharedOldACarrierCoreEmbedding A B.toRelStructure
          (activeCarrier A B α) D f)
        (attachedCoreAEdgeCarrier A B.toRelStructure
          (activeCarrier A B α) D f)).FullSystemGirthGT (g ν)) :
    (generatedActualASupportTrain A hA B.toRelStructure
      (activeCarrier A B α) D f oldTrain coreTrain hShared).AdjacentParameters
        (fun e : ActualAttachedAEdge A B.toRelStructure
          (activeCarrier A B α) D f => e.1)
        allowed := by
  intro μ ν hμν hSucc
  have hOldAt : ∀ i : I,
      TrainParentIntersectionBound
        (oldTrain.wagonClassCarrier
          (attachedOldAEdgeCarrier A B.toRelStructure
            (activeCarrier A B α) D f i) μ)
        (oldTrain.wagonParent μ ν hμν) (allowed ν) :=
    fun i => hOld i μ ν hμν hSucc
  have hCoreAt :
      TrainParentIntersectionBound
        (coreTrain.wagonClassCarrier
          (attachedCoreAEdgeCarrier A B.toRelStructure
            (activeCarrier A B α) D f) μ)
        (coreTrain.wagonParent μ ν hμν) (allowed ν) :=
    hCore μ ν hμν hSucc
  by_cases hTop : ν.val = m
  · have hνTop : ν = (⟨m, Nat.lt_succ_self m⟩ : Fin (m + 1)) :=
      Fin.ext hTop
    exact activeAttached_actualASupport_parentBound_at_top
      A hA B α D f oldTrain coreTrain μ ν hμν
      hνTop hShared hRel (allowed ν) hOldAt hCoreAt
  · have hInterior : ν.val < m := by omega
    exact activeAttached_actualASupport_parentBound_of_fullSystemGirth
      A hA B α D f oldTrain coreTrain μ ν hμν
      hShared hRel (allowed ν) hOldAt hCoreAt
      (g ν) (hg ν (by omega) hInterior)
      (hFull ν (by omega) hInterior)

end StructuralRamsey.Girth
