import Girth.TrainSupremeVertexCoverage
import Girth.TrainInteriorParentQuotientBridge

/-!
# Physical support edges at every connector of a supreme witness cycle

A global supreme plan supplies an actual edge of its chosen copy at each
source connector, including wagon connectors. This needs a copy-incidence
generation premise for retained labels; it holds definitionally for the
genuine shared witness. This is NOT a replacement cycle or a transfer of
the reduced witness label to an original designated B-copy.
-/

namespace StructuralRamsey.Girth.OrderOneData

universe v
variable {V E I P : Type v} (D : OrderOneData V E I P)

/-- A designated copy's vertex and wagon incidences are witnessed by
one of its actual support edges, rather than an unrelated carrier. -/
def CopyIncidenceEdgeGenerated : Prop :=
  ∀ (i : I) (q : V ⊕ P), D.Incident (Sum.inl i) q →
    ∃ e : E, e ∈ D.copyEdges i ∧ D.Incident (Sum.inr e) q

/-- Every connector, not only every vertex connector, has a physical
support edge in the *same* designated copy selected by the plan. -/
theorem BigCycle.supreme_copy_incident_edge_at_every_connector
    {n : ℕ} (C : D.BigCycle n)
    (hGenerate : D.CopyIncidenceEdgeGenerated)
    (hSupreme : C.HasSimultaneousSupreme) :
    ∃ (k : Fin n) (i : I), C.label k = Sum.inl i ∧
      ∀ (j : Fin n), ∃ e : E,
        e ∈ D.copyEdges i ∧ D.Incident (Sum.inr e) (C.connector j) := by
  obtain ⟨k, hk, pieces, hValid, _hLegal⟩ := hSupreme
  cases hLabel : C.label k with
  | inl i =>
      refine ⟨k, i, hLabel, ?_⟩
      intro j
      by_cases hEq : C.label j = C.label k
      · have hInc : D.Incident (Sum.inl i) (C.connector j) := by
          simpa only [hEq, hLabel] using C.left_incident j
        exact hGenerate i (C.connector j) hInc
      · have hPiece := (hValid j).2 hEq
        cases hChosen : pieces j with
        | keep =>
            simp [hChosen] at hPiece
        | short e =>
            have hShort : C.ShortValid D k j e := by
              simpa only [hChosen] using hPiece
            refine ⟨e, ?_, hShort.2.2⟩
            simpa only [hLabel, OrderOneData.edges] using hShort.1
        | long e w f =>
            have hLong : C.LongValid D k j e w f := by
              simpa only [hChosen] using hPiece
            obtain ⟨x, y, _hPrev, hCurrent, _he, hf,
              _hne, _hpE, _hpF, _hx, hy, _hPair⟩ := hLong
            refine ⟨f, ?_, ?_⟩
            · simpa only [hLabel, OrderOneData.edges] using hf
            · simpa only [hCurrent, OrderOneData.Incident,
                OrderOneData.carrier] using hy
  | inr e =>
      simp [OrderOneData.designated, hLabel] at hk

end StructuralRamsey.Girth.OrderOneData

namespace StructuralRamsey.Girth

universe v
variable {W CoreEdge Shared I : Type v}

/-- The genuine shared witness's copy incidences are generated by
actual core edges from the specific chosen shared-edge embedding. -/
theorem sharedWitnessOrderOneData_copyIncidenceEdgeGenerated
    {m : ℕ} (T : EdgeTrainLevels CoreEdge m)
    (μ : Fin (m + 1))
    (embed : I → Shared ↪ CoreEdge)
    (carrier : CoreEdge → Set W) :
    (sharedWitnessOrderOneData T μ embed carrier).CopyIncidenceEdgeGenerated := by
  intro i q hInc
  cases q with
  | inl x =>
      change ∃ s : Shared, x ∈ carrier (embed i s) at hInc
      obtain ⟨s, hs⟩ := hInc
      refine ⟨embed i s, ⟨s, rfl⟩, ?_⟩
      exact hs
  | inr p =>
      change ∃ e : CoreEdge,
        e ∈ Set.range (embed i) ∧
        Quotient.mk (T.wagonSetoid μ) e = p at hInc
      obtain ⟨e, he, hp⟩ := hInc
      refine ⟨e, he, ?_⟩
      exact ⟨e, rfl, hp⟩

/-- A supreme plan on the genuine reduced witness provides a REAL shared
support edge at every (vertex or wagon) cut connector. The shared source
preimage is recorded, so it can be embedded into the chosen standard. -/
theorem sharedWitness_supreme_shared_edge_at_every_connector
    {m : ℕ} (T : EdgeTrainLevels CoreEdge m)
    (μ : Fin (m + 1))
    (embed : I → Shared ↪ CoreEdge)
    (carrier : CoreEdge → Set W)
    {n : ℕ}
    (Z : (sharedWitnessOrderOneData T μ embed carrier).BigCycle n)
    (hSup : Z.HasSimultaneousSupreme) :
    ∃ (k : Fin n) (i : I), Z.label k = Sum.inl i ∧
      ∀ j : Fin n, ∃ s : Shared,
        (sharedWitnessOrderOneData T μ embed carrier).Incident
          (Sum.inr (embed i s)) (Z.connector j) := by
  let D := sharedWitnessOrderOneData T μ embed carrier
  obtain ⟨k, i, hLabel, hSupport⟩ :=
    Z.supreme_copy_incident_edge_at_every_connector D
      (sharedWitnessOrderOneData_copyIncidenceEdgeGenerated T μ embed carrier)
      hSup
  refine ⟨k, i, hLabel, ?_⟩
  intro j
  obtain ⟨e, he, hInc⟩ := hSupport j
  change e ∈ Set.range (embed i) at he
  obtain ⟨s, hs⟩ := he
  subst e
  exact ⟨s, hInc⟩

end StructuralRamsey.Girth
