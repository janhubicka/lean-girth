import Girth.TrainPictureWagonGenerators
import Girth.TrainPhysicalWagonBridge

/-!
# Exact generated wagon equivalence from actual shared gluing edges

An edge-generating picture step has core and standard-picture wagon
classes. Every shared old-to-core wagon contact is witnessed by
an ACTUAL shared physical edge. The verified physical-bridge
theorem then discharges the last abstract bridge hypothesis
of the explicit-generator normal form.

Thus the true generated equivalence is the kernel of the
shared/private ancestor labelling, assuming only that all
output edges are represented by the core or some standard picture,
that the labels respect those representations, and that genuine
shared edges and their old/core wagon classes agree as claimed.

This is a one-cut theorem. Parameter intersections, the higher
A1--A3 system-Girth conditions and the recursive Ramsey
existence theorem are not asserted.
-/

namespace StructuralRamsey.Girth

universe v
variable {E Core Old I CoreEdge OldEdge Shared : Type v}

/-- The least physical-edge relation generated by all core and
standard-copy wagon links has precisely the shared/private normal
form, with its bridge supplied by ACTUAL common gluing edges. -/
theorem pictureWagonGenerated_iff_sameTag_of_sharedEdges
    (coreEmbed : CoreEdge → E)
    (std : I → OldEdge → E)
    (coreClass : CoreEdge → Core)
    (oldClass : OldEdge → Old)
    (old : I → Shared → Old)
    (core : I → Shared → Core)
    (hPreserve : ∀ i s t,
      old i s = old i t → core i s = core i t)
    (sharedOld : I → Shared → OldEdge)
    (sharedCore : I → Shared → CoreEdge)
    (hOldClass : ∀ i s, oldClass (sharedOld i s) = old i s)
    (hCoreClass : ∀ i s, coreClass (sharedCore i s) = core i s)
    (hGlue : ∀ i s, std i (sharedOld i s) =
      coreEmbed (sharedCore i s))
    (tag : E → Core ⊕ (I × Old))
    (hCoreTag : ∀ b, tag (coreEmbed b) = Sum.inl (coreClass b))
    (hStdTag : ∀ i b,
      tag (std i b) =
        gluedStandardNode
          (wagonContactGlue (wagonSharedEdgeContact old core))
          i (oldClass b))
    (hCover : ∀ e : E,
      (∃ b, e = coreEmbed b) ∨ ∃ i b, e = std i b) :
    ∀ e f : E,
      TrainEdgeGenerated
        (PictureWagonStep coreEmbed std coreClass oldClass) e f ↔
      tag e = tag f := by
  apply pictureWagonGenerated_iff_sameTag
    coreEmbed std coreClass oldClass
    (wagonContactGlue (wagonSharedEdgeContact old core))
    tag hCoreTag hStdTag hCover
  intro i b c hContact
  have hStandard : ∀ j a d,
      oldClass a = oldClass d →
      TrainEdgeGenerated
        (PictureWagonStep coreEmbed std coreClass oldClass)
        (std j a) (std j d) := by
    intro j a d h
    exact TrainEdgeGenerated.basic _ _
      (PictureWagonStep.standard j a d h)
  obtain ⟨d, hd, hEdge⟩ :=
    sharedWagonContact_has_physicalBridge
      old core hPreserve std coreEmbed
      sharedOld sharedCore oldClass coreClass
      hOldClass hCoreClass hGlue
      (TrainEdgeGenerated
        (PictureWagonStep coreEmbed std coreClass oldClass))
      hStandard i b c hContact
  exact ⟨d, hd, hEdge⟩

end StructuralRamsey.Girth
