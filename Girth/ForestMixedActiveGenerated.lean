import Girth.ForestMixedIrreducibleCoverage
import Girth.DesignatedPicture

/-!
# True active subsystems remain A-generated under mixed coverage

The original circulation picture proof used the stronger condition
that all irreducibles belong to designated B-copies to show the
active subsystem is generated by A. This is too strong for an
unpruned recursive local witness with ambient A-edges outside all
designated local gluing copies.

Here we use the correct mixed B-or-A irreducible coverage. If the
tuple lies inside an actual A-copy, A-linearity of the base and the
rigidity of its ordered A-projection force that A-copy to have the
current active projection, so it is itself an active A-copy.
If the tuple lies inside a designated B-copy, the previous standard
A-strong base argument applies unchanged.

The resulting active A-generation statement requires the honest
partite projection and base A-linearity/rigidity, but no local
A-edge-to-designated-B coverage. It is the bridge needed to close
the recursive nonpruning picture induction.
-/

namespace StructuralRamsey.Girth

open StructuralRamsey.RelStructure
universe u v
variable {L : RelLanguage.{u}}
variable {UA VB P X : Type v}

theorem activeSubsystem_aGenerated_of_mixedCoverage
    (A : RelStructure L UA)
    (B : RelStructure L VB)
    (D : RelStructure L P)
    (C : StructuralRamsey.Partite.System L P X)
    (family : Set (RelStructure.Embedding B D))
    (hA : A.Irreducible)
    (hPartite : C.IsPartiteOver D)
    (hLinear : ALinear A D)
    (hCover : DesignatedBorACoversIrreducibles A B D C family)
    (hBaseStrong :
      ∀ b : RelStructure.Embedding B D, b ∈ family →
        AStrong A D (copyCarrier b))
    (e : RelStructure.Embedding A D)
    (hRigid : ∀ b : RelStructure.Embedding A D,
      SameCopy b e → b = e)
    (hActive : (activeCarrier A C e.toFunctionEmbedding).Nonempty) :
    AGenerated A
      (C.toRelStructure.induce
        (activeCarrier A C e.toFunctionEmbedding)) := by
  classical
  let S := activeCarrier A C e.toFunctionEmbedding
  let inc : RelStructure.Embedding (C.toRelStructure.induce S)
      C.toRelStructure :=
    RelStructure.inclusion C.toRelStructure S
  constructor
  · intro x
    rcases x.2 with ⟨a, u, hu⟩
    let aS : RelStructure.Embedding A (C.toRelStructure.induce S) := {
      toFun := fun z => ⟨a.val z, projected_mem_activeCarrier A C
        e.toFunctionEmbedding a z⟩
      injective := by
        intro z w h
        apply a.val.injective
        exact congrArg Subtype.val h
      map_rel_iff := by
        intro R t
        change C.rel R (a.val ∘ t) ↔ A.rel R t
        exact a.val.map_rel_iff R t
    }
    refine ⟨aS, ?_⟩
    refine ⟨u, ?_⟩
    apply Subtype.ext
    exact hu
  · intro R t ht
    let T : Set S := Set.range t
    by_cases hTsub : T.Subsingleton
    · by_cases har : 0 < L.arity R
      · let i0 : Fin (L.arity R) := ⟨0, har⟩
        have hi0 : (t i0).1 ∈ S := (t i0).2
        rcases hi0 with ⟨a, u, hu⟩
        let aS : RelStructure.Embedding A (C.toRelStructure.induce S) := {
          toFun := fun z => ⟨a.val z, projected_mem_activeCarrier A C
            e.toFunctionEmbedding a z⟩
          injective := by
            intro z w h
            apply a.val.injective
            exact congrArg Subtype.val h
          map_rel_iff := by
            intro Q s
            change C.rel Q (a.val ∘ s) ↔ A.rel Q s
            exact a.val.map_rel_iff Q s
        }
        refine ⟨aS, ?_⟩
        intro i
        have hti : t i = t i0 := by
          apply hTsub
          · exact ⟨i, rfl⟩
          · exact ⟨i0, rfl⟩
        refine ⟨u, ?_⟩
        apply Subtype.ext
        change a.val u = (t i).1
        rw [hti]
        exact hu
      · rcases hActive with ⟨x, hx⟩
        rcases hx with ⟨a, _, _⟩
        let aS : RelStructure.Embedding A (C.toRelStructure.induce S) := {
          toFun := fun z => ⟨a.val z, projected_mem_activeCarrier A C
            e.toFunctionEmbedding a z⟩
          injective := by
            intro z w h
            apply a.val.injective
            exact congrArg Subtype.val h
          map_rel_iff := by
            intro Q s
            change C.rel Q (a.val ∘ s) ↔ A.rel Q s
            exact a.val.map_rel_iff Q s
        }
        refine ⟨aS, ?_⟩
        intro i
        exact (har (Nat.zero_lt_of_lt i.isLt)).elim
    · have hTIrr :
          ((C.toRelStructure.induce S).induce T).Irreducible := by
        intro x y hxy
        rcases x.2 with ⟨ix, hix⟩
        rcases y.2 with ⟨iy, hiy⟩
        have hixy : ix ≠ iy := by
          intro h
          apply hxy
          apply Subtype.ext
          rw [← hix, ← hiy, h]
        let z : Fin (L.arity R) → T :=
          fun i => ⟨t i, ⟨i, rfl⟩⟩
        refine ⟨R, z, ix, iy, ?_, ?_, ?_⟩
        · change (C.toRelStructure.induce S).rel R
            (Subtype.val ∘ z)
          convert ht using 1
          funext i
          rfl
        · apply Subtype.ext
          exact hix
        · apply Subtype.ext
          exact hiy
      let inclT :
          RelStructure.Embedding
            ((C.toRelStructure.induce S).induce T)
            C.toRelStructure :=
        inc.comp (RelStructure.inclusion
          (C.toRelStructure.induce S) T)
      let TRng : Set X := Set.range inclT
      have hTRngIrr :
          (C.toRelStructure.induce TRng).Irreducible :=
        hTIrr.range_embedding inclT
      rcases hCover TRng hTRngIrr with ⟨q, hq⟩ | ⟨aC, hACover⟩
      ·
        have hPartInE :
            ∀ i : Fin (L.arity R),
              C.part ((t i).1) ∈ copyCarrier e := by
          intro i
          exact activeCarrier_part_in_baseCopy A D C e (t i).2
        have hPartInB :
            ∀ i : Fin (L.arity R),
              C.part ((t i).1) ∈ copyCarrier q.base := by
          intro i
          have hmem : (t i).1 ∈ TRng := by
            exact ⟨⟨t i, ⟨i, rfl⟩⟩, rfl⟩
          obtain ⟨b, hb⟩ := hq ⟨(t i).1, hmem⟩
          refine ⟨b, ?_⟩
          calc
            q.base b = C.part (q.embedding b) := (q.projects b).symm
            _ = C.part ((t i).1) := congrArg C.part hb.symm
        have hPartNonSub :
            ¬ (copyCarrier e ∩ copyCarrier q.base).Subsingleton := by
          intro hs
          rw [Set.not_subsingleton_iff] at hTsub
          rcases hTsub with ⟨x, hxT, y, hyT, hxy⟩
          rcases hxT with ⟨ix, hix⟩
          rcases hyT with ⟨iy, hiy⟩
          have hxyVal : (t ix).1 ≠ (t iy).1 := by
            intro h
            apply hxy
            apply Subtype.ext
            simpa [hix, hiy] using h
          have hpartNe :
              C.part ((t ix).1) ≠ C.part ((t iy).1) := by
            intro hp
            apply hxyVal
            exact C.transversal R (Subtype.val ∘ t) ht ix iy hp
          apply hpartNe
          exact hs
            ⟨hPartInE ix, hPartInB ix⟩
            ⟨hPartInE iy, hPartInB iy⟩
        have hEsub :
            copyCarrier e ⊆ copyCarrier q.base :=
          hBaseStrong q.base q.base_mem e hPartNonSub
        have hFactor :
            ∀ a : UA, ∃ b : VB, e a = q.base b := by
          intro a
          rcases hEsub ⟨a, rfl⟩ with ⟨b, hb⟩
          exact ⟨b, hb.symm⟩
        let eB : RelStructure.Embedding A B :=
          e.factorThroughRange q.base hFactor
        have heB (a : UA) : e a = q.base (eB a) :=
          Classical.choose_spec (hFactor a)
        let aC : RelStructure.Embedding A C.toRelStructure :=
          q.embedding.comp eB
        have hTupleIn :
            ∀ i : Fin (L.arity R), (t i).1 ∈ copyCarrier aC := by
          intro i
          have hmem : (t i).1 ∈ TRng := by
            exact ⟨⟨t i, ⟨i, rfl⟩⟩, rfl⟩
          obtain ⟨b, hb⟩ := hq ⟨(t i).1, hmem⟩
          obtain ⟨a0, ha0⟩ := hPartInE i
          have hparts :
              q.base b = q.base (eB a0) := by
            calc
              q.base b = C.part (q.embedding b) := (q.projects b).symm
              _ = C.part ((t i).1) := congrArg C.part hb.symm
              _ = e a0 := ha0.symm
              _ = q.base (eB a0) := heB a0
          have hbEq : b = eB a0 := q.base.injective hparts
          refine ⟨a0, ?_⟩
          change q.embedding (eB a0) = (t i).1
          rw [← hbEq]
          exact hb.symm
        have hACsub : copyCarrier aC ⊆ S := by
          intro z hz
          rcases hz with ⟨a0, rfl⟩
          -- Every vertex of eB(A) projects to e(A), hence belongs to an active
          -- A-copy; use the copy aC itself with the prescribed projection e.
          refine ⟨⟨aC, ?_⟩, a0, rfl⟩
          intro a
          calc
            C.part (aC a) = q.base (eB a) := q.projects (eB a)
            _ = e a := (heB a).symm
        have hActiveFactor :
            ∀ a0 : UA, ∃ s : S, aC a0 = inc s := by
          intro a0
          exact ⟨⟨aC a0, hACsub ⟨a0, rfl⟩⟩, rfl⟩
        let aS' : RelStructure.Embedding A
            (C.toRelStructure.induce S) :=
          aC.factorThroughRange inc hActiveFactor
        have haS' (a0 : UA) : aC a0 = inc (aS' a0) :=
          Classical.choose_spec (hActiveFactor a0)
        refine ⟨aS', ?_⟩
        intro i
        rcases hTupleIn i with ⟨a0, ha0⟩
        refine ⟨a0, ?_⟩
        apply Subtype.ext
        have hval :
            (aS' a0).1 = aC a0 := by
          have h := (haS' a0).symm
          change inc (aS' a0) = aC a0 at h
          exact h
        exact hval.trans ha0
      · obtain ⟨b, hb⟩ := hPartite.after_irreducible_embedding hA aC
        have hPartInE :
            ∀ i : Fin (L.arity R),
              C.part ((t i).1) ∈ copyCarrier e := by
          intro i
          exact activeCarrier_part_in_baseCopy A D C e (t i).2
        have hPartInA :
            ∀ i : Fin (L.arity R),
              C.part ((t i).1) ∈ copyCarrier b := by
          intro i
          have hmem : (t i).1 ∈ TRng :=
            ⟨⟨t i, ⟨i, rfl⟩⟩, rfl⟩
          obtain ⟨u, hu⟩ := hACover ⟨(t i).1, hmem⟩
          refine ⟨u, ?_⟩
          calc
            b u = C.part (aC u) := hb u
            _ = C.part ((t i).1) := congrArg C.part hu
        have hPartNonSub :
            ¬ (copyCarrier e ∩ copyCarrier b).Subsingleton := by
          intro hs
          rw [Set.not_subsingleton_iff] at hTsub
          rcases hTsub with ⟨x, hxT, y, hyT, hxy⟩
          rcases hxT with ⟨ix, hix⟩
          rcases hyT with ⟨iy, hiy⟩
          have hxyVal : (t ix).1 ≠ (t iy).1 := by
            intro h
            apply hxy
            apply Subtype.ext
            simpa [hix, hiy] using h
          have hpartNe :
              C.part ((t ix).1) ≠ C.part ((t iy).1) := by
            intro hp
            apply hxyVal
            exact C.transversal R (Subtype.val ∘ t) ht ix iy hp
          apply hpartNe
          exact hs
            ⟨hPartInE ix, hPartInA ix⟩
            ⟨hPartInE iy, hPartInA iy⟩
        have hSame : SameCopy e b := by
          by_contra hne
          exact hPartNonSub (hLinear e b hne)
        have hBaseEq : b = e := hRigid b hSame.symm
        let aProjected :
            StructuralRamsey.Partite.ProjectedEmbedding
              A C e.toFunctionEmbedding :=
          ⟨aC, fun u => by
            change C.part (aC u) = e u
            calc
              C.part (aC u) = b u := (hb u).symm
              _ = e u :=
                congrArg (fun k : RelStructure.Embedding A D => k u)
                  hBaseEq⟩
        have hACsub : copyCarrier aC ⊆ S := by
          rintro z ⟨u, rfl⟩
          exact projected_mem_activeCarrier A C
            e.toFunctionEmbedding aProjected u
        have hActiveFactor :
            ∀ u : UA, ∃ s : S, aC u = inc s := by
          intro u
          exact ⟨⟨aC u, hACsub ⟨u, rfl⟩⟩, rfl⟩
        let aS' : RelStructure.Embedding A
            (C.toRelStructure.induce S) :=
          aC.factorThroughRange inc hActiveFactor
        refine ⟨aS', ?_⟩
        intro i
        have hmem : (t i).1 ∈ TRng :=
          ⟨⟨t i, ⟨i, rfl⟩⟩, rfl⟩
        obtain ⟨u, hu⟩ := hACover ⟨(t i).1, hmem⟩
        refine ⟨u, ?_⟩
        apply Subtype.ext
        have hvalue : (aS' u).1 = aC u := by
          have hSpec := Classical.choose_spec (hActiveFactor u)
          exact hSpec.symm
        exact hvalue.trans hu

end StructuralRamsey.Girth
