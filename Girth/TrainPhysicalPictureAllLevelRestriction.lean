import Girth.TrainPhysicalPictureGeneratedTrain
import Girth.TrainPhysicalPictureExactRestriction

/-!
# Exact old/core restrictions of EVERY generated train cut

The generated physical picture train is an actual nested hierarchy.
At each fixed horizontal cut its elementary wagon relation is
generated by the true core and full standard wagon relations.

Preservation of the shared-subsystem old wagon equivalence is enough
for the tagged normal form. Reflection is ALSO required to show that
no two distinct old standard wagons collapse through the core.
These hypotheses are exactly what a genuine train embedding provides.

This module derives exact restriction across ALL train levels at once.
It does not assert the sibling-parameter intersection bound or
acceptable-cycle system-Girth A1--A3.
-/

namespace StructuralRamsey.Girth

universe v
variable {Shared OldEdge CoreEdge I : Type v}

/-- At every horizontal cut the generated physical picture train
restricts EXACTLY to the old standard-picture equivalence. -/
theorem physicalPictureGeneratedTrain_restrict_standard
    {m : ℕ}
    (oldTrain : EdgeTrainLevels OldEdge m)
    (coreTrain : EdgeTrainLevels CoreEdge m)
    (inOld : Shared ↪ OldEdge)
    (inCore : I → Shared ↪ CoreEdge)
    (hRel : ∀ (μ : Fin (m + 1)) (i : I) (s t : Shared),
      oldTrain.rel μ (inOld s) (inOld t) ↔
        coreTrain.rel μ (inCore i s) (inCore i t))
    (hShared : ∀ i : I, Nonempty Shared)
    (μ : Fin (m + 1)) (i : I) (a b : OldEdge) :
    (physicalPictureGeneratedTrain
      oldTrain coreTrain inOld inCore hShared).rel μ
        (physicalStandardEdge inOld inCore i a)
        (physicalStandardEdge inOld inCore i b) ↔
      oldTrain.rel μ a b := by
  let coreClass : CoreEdge → Quotient (coreTrain.wagonSetoid μ) :=
    fun x => Quotient.mk (coreTrain.wagonSetoid μ) x
  let oldClass : OldEdge → Quotient (oldTrain.wagonSetoid μ) :=
    fun x => Quotient.mk (oldTrain.wagonSetoid μ) x
  have hp : ∀ j s t,
      oldClass (inOld s) = oldClass (inOld t) →
        coreClass (inCore j s) = coreClass (inCore j t) := by
    intro j s t h
    exact Quotient.sound ((hRel μ j s t).mp (Quotient.exact h))
  have hr : ∀ j s t,
      coreClass (inCore j s) = coreClass (inCore j t) →
        oldClass (inOld s) = oldClass (inOld t) := by
    intro j s t h
    exact Quotient.sound ((hRel μ j s t).mpr (Quotient.exact h))
  have hOld :
      TrainEdgeGenerated
        (PictureWagonStep
          (physicalCoreEdge inOld I)
          (physicalStandardEdge inOld inCore)
          coreClass oldClass)
        (physicalStandardEdge inOld inCore i a)
        (physicalStandardEdge inOld inCore i b) ↔
          oldClass a = oldClass b :=
    physicalPictureGenerated_restrict_standard
      inOld inCore coreClass oldClass hp hr i a b
  change
    TrainEdgeGenerated
      (PictureWagonStep
        (physicalCoreEdge inOld I)
        (physicalStandardEdge inOld inCore)
        coreClass oldClass)
      (physicalStandardEdge inOld inCore i a)
      (physicalStandardEdge inOld inCore i b) ↔
        oldTrain.rel μ a b
  exact hOld.trans ⟨Quotient.exact, Quotient.sound⟩

/-- Exact restriction to the core holds under preservation of the
shared train relations; no reflection is needed on the core side. -/
theorem physicalPictureGeneratedTrain_restrict_core
    {m : ℕ}
    (oldTrain : EdgeTrainLevels OldEdge m)
    (coreTrain : EdgeTrainLevels CoreEdge m)
    (inOld : Shared ↪ OldEdge)
    (inCore : I → Shared ↪ CoreEdge)
    (hPreserve : ∀ (μ : Fin (m + 1)) (i : I) (s t : Shared),
      oldTrain.rel μ (inOld s) (inOld t) →
        coreTrain.rel μ (inCore i s) (inCore i t))
    (hShared : ∀ i : I, Nonempty Shared)
    (μ : Fin (m + 1)) (a b : CoreEdge) :
    (physicalPictureGeneratedTrain
      oldTrain coreTrain inOld inCore hShared).rel μ
        (physicalCoreEdge inOld I a)
        (physicalCoreEdge inOld I b) ↔
      coreTrain.rel μ a b := by
  let coreClass : CoreEdge → Quotient (coreTrain.wagonSetoid μ) :=
    fun x => Quotient.mk (coreTrain.wagonSetoid μ) x
  let oldClass : OldEdge → Quotient (oldTrain.wagonSetoid μ) :=
    fun x => Quotient.mk (oldTrain.wagonSetoid μ) x
  have hp : ∀ j s t,
      oldClass (inOld s) = oldClass (inOld t) →
        coreClass (inCore j s) = coreClass (inCore j t) := by
    intro j s t h
    exact Quotient.sound (hPreserve μ j s t (Quotient.exact h))
  let touch := wagonSharedEdgeContact
    (fun (_ : I) s => oldClass (inOld s))
    (fun j s => coreClass (inCore j s))
  let glue := wagonContactGlue touch
  let tag := physicalPictureWagonTag inOld coreClass oldClass glue
  let R : PhysicalPictureEdge inOld I CoreEdge →
      PhysicalPictureEdge inOld I CoreEdge → Prop :=
    TrainEdgeGenerated (physicalPictureCutStep
      oldTrain coreTrain μ inOld inCore)
  have hTag : ∀ x y, R x y ↔ tag x = tag y :=
    physicalPictureGenerated_iff_tag
      inOld inCore coreClass oldClass hp
  have hCore :
      R (physicalCoreEdge inOld I a) (physicalCoreEdge inOld I b) ↔
        coreClass a = coreClass b := by
    exact normalForm_restrict_core
      R tag hTag (physicalCoreEdge inOld I)
      coreClass
      (physicalCoreEdge_tag inOld coreClass oldClass glue)
      a b
  change
    R (physicalCoreEdge inOld I a) (physicalCoreEdge inOld I b) ↔
      coreTrain.rel μ a b
  exact hCore.trans ⟨Quotient.exact, Quotient.sound⟩

end StructuralRamsey.Girth
