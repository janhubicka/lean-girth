StructuralRamsey.Girth.ACopyLayeredStar.generated_zero_iff_shared.{u, v, w, z} {Core : Type u} {I : Type v}
  {Source : I → Type w} {Shared : I → Type z} (D : Diagram Core I Source Shared) (x y : Raw) :
  Generated D 0 x y ↔ Relation.EqvGen (SharedStep D) x y
StructuralRamsey.Girth.ACopyLayeredStar.generated_nested.{u, v, w, z} {Core : Type u} {I : Type v} {Source : I → Type w}
  {Shared : I → Type z} (D : Diagram Core I Source Shared) {m n : ℕ} (hmn : m ≤ n) {x y : Raw} (h : Generated D m x y) :
  Generated D n x y
StructuralRamsey.Girth.ACopyLayeredStar.generated_iff_normal.{u, v, w, z} {Core : Type u} {I : Type v}
  {Source : I → Type w} {Shared : I → Type z} (D : Diagram Core I Source Shared) (n : ℕ) (x y : Raw) :
  Generated D n x y ↔
    ClassStar.normal (SourceStar.contact (D.coreEq n) (D.sourceEq n) D.alpha D.beta)
        (SourceStar.classes (D.coreEq n) (D.sourceEq n) x) =
      ClassStar.normal (SourceStar.contact (D.coreEq n) (D.sourceEq n) D.alpha D.beta)
        (SourceStar.classes (D.coreEq n) (D.sourceEq n) y)
StructuralRamsey.Girth.ACopyLayeredStar.nodeSetoid_mk_iff.{u, v, w, z} {Core : Type u} {I : Type v}
  {Source : I → Type w} {Shared : I → Type z} (D : Diagram Core I Source Shared) (n : ℕ) (x y : Raw) :
  (nodeSetoid D n) (Quot.mk (Step D 0) x) (Quot.mk (Step D 0) y) ↔ Generated D n x y
StructuralRamsey.Girth.ACopyLayeredStar.nodeSetoid_source_iff.{u, v, w, z} {Core : Type u} {I : Type v}
  {Source : I → Type w} {Shared : I → Type z} (D : Diagram Core I Source Shared) (n : ℕ) (i : I) (a b : Source i) :
  (nodeSetoid D n) (nodeSource D i a) (nodeSource D i b) ↔ (D.sourceEq n i) a b
StructuralRamsey.Girth.ACopyLayeredStar.parent_sourceMap.{u, v, w, z} {Core : Type u} {I : Type v} {Source : I → Type w}
  {Shared : I → Type z} (D : Diagram Core I Source Shared) {m n : ℕ} (hmn : m ≤ n) (i : I)
  (a : Quotient (D.sourceEq m i)) : parent D hmn (sourceMap D m i a) = sourceMap D n i (sourceParent D hmn i a)
StructuralRamsey.Girth.ACopyLayeredStar.contact_parent.{u, v, w, z} {Core : Type u} {I : Type v} {Source : I → Type w}
  {Shared : I → Type z} (D : Diagram Core I Source Shared) {m n : ℕ} (hmn : m ≤ n) (i : I)
  (a : Quotient (D.sourceEq m i)) (c : Quotient (D.coreEq m)) (h : contact D m i a = some c) :
  contact D n i (sourceParent D hmn i a) = some (coreParent D hmn c)
StructuralRamsey.Girth.ACopyLayeredStar.parent_sourceMap_eq_coreMap_iff.{u, v, w, z} {Core : Type u} {I : Type v}
  {Source : I → Type w} {Shared : I → Type z} (D : Diagram Core I Source Shared) {m n : ℕ} (hmn : m ≤ n) (i : I)
  (a : Quotient (D.sourceEq m i)) (c : Quotient (D.coreEq n)) :
  parent D hmn (sourceMap D m i a) = coreMap D n c ↔ contact D n i (sourceParent D hmn i a) = some c
StructuralRamsey.Girth.ACopyLayeredStar.nodeWagonEquiv.{u, v, w, z} {Core : Type u} {I : Type v} {Source : I → Type w}
  {Shared : I → Type z} (D : Diagram Core I Source Shared) (n : ℕ) : Quotient (nodeSetoid D n) ≃ Wagon D n
StructuralRamsey.Girth.ACopyLayeredStar.generated_top.{u, v, w, z} {Core : Type u} {I : Type v} {Source : I → Type w}
  {Shared : I → Type z} (D : Diagram Core I Source Shared) (top : ℕ) (hCore : ∀ (c d : Core), (D.coreEq top) c d)
  (hSource : ∀ (i : I) (a b : Source i), (D.sourceEq top i) a b) (hShared : ∀ (i : I), Nonempty (Shared i))
  (x y : Raw) : Generated D top x y
StructuralRamsey.Girth.ACopyLayeredStar.uniqueTop.{u, v, w, z} {Core : Type u} {I : Type v} {Source : I → Type w}
  {Shared : I → Type z} (D : Diagram Core I Source Shared) [Nonempty Core] (top : ℕ)
  (hCore : ∀ (c d : Core), (D.coreEq top) c d) (hSource : ∀ (i : I) (a b : Source i), (D.sourceEq top i) a b)
  (hShared : ∀ (i : I), Nonempty (Shared i)) : Unique (Wagon D top)
