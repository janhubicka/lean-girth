StructuralRamsey.Girth.ACopyExactStar.SourceStar.generated_distinct_sources_iff.{u, v, w, z} {Core : Type u}
  {I : Type v} {Source : I → Type w} {Shared : I → Type z} (coreEq : Setoid Core)
  (sourceEq : (i : I) → Setoid (Source i)) (alpha : (i : I) → Shared i → Core) (beta : (i : I) → Shared i → Source i)
  (compatible : ∀ (i : I) (s t : Shared i), coreEq (alpha i s) (alpha i t) ↔ (sourceEq i) (beta i s) (beta i t))
  (i j : I) (hij : i ≠ j) (a : Source i) (b : Source j) :
  SourceStar.Generated coreEq sourceEq alpha beta (Sum.inr ⟨i, a⟩) (Sum.inr ⟨j, b⟩) ↔
    ∃ c,
      SourceStar.Generated coreEq sourceEq alpha beta (Sum.inr ⟨i, a⟩) (Sum.inl c) ∧
        SourceStar.Generated coreEq sourceEq alpha beta (Sum.inr ⟨j, b⟩) (Sum.inl c)
StructuralRamsey.Girth.ACopyExactStar.SourceStar.quotientEquiv.{u, v, w, z} {Core : Type u} {I : Type v}
  {Source : I → Type w} {Shared : I → Type z} (coreEq : Setoid Core) (sourceEq : (i : I) → Setoid (Source i))
  (alpha : (i : I) → Shared i → Core) (beta : (i : I) → Shared i → Source i)
  (compatible : ∀ (i : I) (s t : Shared i), coreEq (alpha i s) (alpha i t) ↔ (sourceEq i) (beta i s) (beta i t)) :
  Quot (SourceStar.Step coreEq sourceEq alpha beta) ≃
    ↑(Set.range (ClassStar.normal (SourceStar.contact coreEq sourceEq alpha beta)))
StructuralRamsey.Girth.ACopyExactStar.ClassStar.normal_range_iff.{u, v, w} {Core : Type u} {I : Type v}
  {Source : I → Type w} (contact : (i : I) → Source i → Option Core) (x : ClassStar.Raw Core Source) :
  x ∈ Set.range (ClassStar.normal contact) ↔
    match x with
    | Sum.inl val => True
    | Sum.inr ⟨i, a⟩ => contact i a = none
StructuralRamsey.Girth.ACopyExactStar.SourceStar.private_label_range_iff.{u, v, w, z} {Core : Type u} {I : Type v}
  {Source : I → Type w} {Shared : I → Type z} (coreEq : Setoid Core) (sourceEq : (i : I) → Setoid (Source i))
  (alpha : (i : I) → Shared i → Core) (beta : (i : I) → Shared i → Source i)
  (compatible : ∀ (i : I) (s t : Shared i), coreEq (alpha i s) (alpha i t) ↔ (sourceEq i) (beta i s) (beta i t)) (i : I)
  (a : Quotient (sourceEq i)) :
  Sum.inr ⟨i, a⟩ ∈ Set.range (ClassStar.normal (SourceStar.contact coreEq sourceEq alpha beta)) ↔ ¬∃ s, ⟦beta i s⟧ = a
