StructuralRamsey.Girth.ACopyExactStar.SourceStar.generated_iff_normal.{u, v, w, z} {Core : Type u} {I : Type v}
  {Source : I → Type w} {Shared : I → Type z} (coreEq : Setoid Core) (sourceEq : (i : I) → Setoid (Source i))
  (alpha : (i : I) → Shared i → Core) (beta : (i : I) → Shared i → Source i)
  (compatible : ∀ (i : I) (s t : Shared i), coreEq (alpha i s) (alpha i t) ↔ (sourceEq i) (beta i s) (beta i t))
  (x y : ClassStar.Raw Core Source) :
  SourceStar.Generated coreEq sourceEq alpha beta x y ↔
    ClassStar.normal (SourceStar.contact coreEq sourceEq alpha beta) (SourceStar.classes coreEq sourceEq x) =
      ClassStar.normal (SourceStar.contact coreEq sourceEq alpha beta) (SourceStar.classes coreEq sourceEq y)
StructuralRamsey.Girth.ACopyExactStar.SourceStar.generated_core_iff.{u, v, w, z} {Core : Type u} {I : Type v}
  {Source : I → Type w} {Shared : I → Type z} (coreEq : Setoid Core) (sourceEq : (i : I) → Setoid (Source i))
  (alpha : (i : I) → Shared i → Core) (beta : (i : I) → Shared i → Source i)
  (compatible : ∀ (i : I) (s t : Shared i), coreEq (alpha i s) (alpha i t) ↔ (sourceEq i) (beta i s) (beta i t))
  (c d : Core) : SourceStar.Generated coreEq sourceEq alpha beta (Sum.inl c) (Sum.inl d) ↔ coreEq c d
StructuralRamsey.Girth.ACopyExactStar.SourceStar.generated_source_iff.{u, v, w, z} {Core : Type u} {I : Type v}
  {Source : I → Type w} {Shared : I → Type z} (coreEq : Setoid Core) (sourceEq : (i : I) → Setoid (Source i))
  (alpha : (i : I) → Shared i → Core) (beta : (i : I) → Shared i → Source i)
  (compatible : ∀ (i : I) (s t : Shared i), coreEq (alpha i s) (alpha i t) ↔ (sourceEq i) (beta i s) (beta i t)) (i : I)
  (a b : Source i) :
  SourceStar.Generated coreEq sourceEq alpha beta (Sum.inr ⟨i, a⟩) (Sum.inr ⟨i, b⟩) ↔ (sourceEq i) a b
StructuralRamsey.Girth.ACopyExactStar.SourceStar.generated_source_core_iff.{u, v, w, z} {Core : Type u} {I : Type v}
  {Source : I → Type w} {Shared : I → Type z} (coreEq : Setoid Core) (sourceEq : (i : I) → Setoid (Source i))
  (alpha : (i : I) → Shared i → Core) (beta : (i : I) → Shared i → Source i)
  (compatible : ∀ (i : I) (s t : Shared i), coreEq (alpha i s) (alpha i t) ↔ (sourceEq i) (beta i s) (beta i t)) (i : I)
  (a : Source i) (c : Core) :
  SourceStar.Generated coreEq sourceEq alpha beta (Sum.inr ⟨i, a⟩) (Sum.inl c) ↔
    ∃ s, (sourceEq i) (beta i s) a ∧ coreEq (alpha i s) c
StructuralRamsey.Girth.ACopyExactStar.SourceStar.core_classMap_injective.{u, v, w, z} {Core : Type u} {I : Type v}
  {Source : I → Type w} {Shared : I → Type z} (coreEq : Setoid Core) (sourceEq : (i : I) → Setoid (Source i))
  (alpha : (i : I) → Shared i → Core) (beta : (i : I) → Shared i → Source i)
  (compatible : ∀ (i : I) (s t : Shared i), coreEq (alpha i s) (alpha i t) ↔ (sourceEq i) (beta i s) (beta i t)) :
